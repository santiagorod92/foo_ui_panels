function(pui_embed_images res_dir out)
  file(GLOB_RECURSE files RELATIVE "${res_dir}" CONFIGURE_DEPENDS "${res_dir}/*.png")
  list(SORT files)
  set(body "// Generated by cmake/embed_images.cmake from res/ — don't edit.\n#include \"${CMAKE_SOURCE_DIR}/src/core/builtin_images.h\"\n\nnamespace pui {\nnamespace {\n")
  set(table "")
  set(i 0)
  foreach(f ${files})
    file(READ "${res_dir}/${f}" hex HEX)
    file(SIZE "${res_dir}/${f}" size)
    string(REGEX REPLACE "([0-9a-f][0-9a-f])" "0x\\1," hex "${hex}")
    string(REGEX REPLACE "(0x..,0x..,0x..,0x..,0x..,0x..,0x..,0x..,0x..,0x..,0x..,0x..,0x..,0x..,0x..,0x..,)" "\\1\n" hex "${hex}")
    string(APPEND body "const unsigned char k${i}[] = {\n${hex}};\n")
    string(APPEND table "    { \"${f}\", k${i}, ${size} },\n")
    set_property(DIRECTORY APPEND PROPERTY CMAKE_CONFIGURE_DEPENDS "${res_dir}/${f}")
    math(EXPR i "${i} + 1")
  endforeach()
  string(APPEND body "const BuiltinImage kImages[] = {\n${table}    { nullptr, nullptr, 0 },\n};\n} // namespace\n\n"
    "const BuiltinImage* find_builtin_image(const std::string& name) {\n"
    "    for (const BuiltinImage* b = kImages; b->name; ++b) if (name == b->name) return b;\n"
    "    return nullptr;\n}\n\n} // namespace pui\n")
  if(EXISTS "${out}")
    file(READ "${out}" old)
  endif()
  if(NOT old STREQUAL body)
    file(WRITE "${out}" "${body}")
  endif()
endfunction()
